---
import type { CollectionEntry } from "astro:content";
import CaseGallery from "../../components/CaseGallery";
import SiteNavigation from "../../components/SiteNavigation";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOrderedSkills, getPublishedProjects, hasContent } from "../../lib/content";
import { buildProjectJsonLd, siteIdentity } from "../../lib/seo";

interface Props {
  project: CollectionEntry<"projects">;
  nextProject: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      nextProject: projects[(index + 1) % projects.length],
    },
  }));
}

const { project, nextProject } = Astro.props;
const { data } = project;
const skills = await getOrderedSkills();
const skillNames = new Map(skills.map(({ id, data: skill }) => [id, skill.name]));
const technologies = data.technologies
  .map((technology) => skillNames.get(technology.id))
  .filter((name): name is string => Boolean(name));

const essentialInformation = [
  { label: "Type de projet", value: data.type },
  { label: "Mon rôle", value: data.role },
  { label: "Durée", value: data.duration },
  { label: "Statut", value: data.status },
].filter(({ value }) => hasContent(value));

const hasExtendedDetails = hasContent(data.context) || hasContent(data.architecture);
const hasPublicLinks = hasContent(data.githubUrl) || hasContent(data.demoUrl);
const canonicalPath = `/projets/${project.id}/`;
const socialImage = data.cover.image.endsWith(".svg") ? siteIdentity.socialImage : data.cover.image;
const socialImageAlt = data.cover.image.endsWith(".svg") ? siteIdentity.socialImageAlt : data.cover.alt;
const socialImageWidth = data.cover.image.endsWith(".svg") ? 1200 : data.cover.width;
const socialImageHeight = data.cover.image.endsWith(".svg") ? 630 : data.cover.height;
const jsonLd = buildProjectJsonLd({
  title: data.title,
  summary: data.summary,
  path: canonicalPath,
  image: socialImage,
  technologies,
}, Astro.site);
---

<BaseLayout
  title={`${data.title} — Étude de cas | Fenotiana Michael`}
  description={data.summary}
  canonicalPath={canonicalPath}
  image={socialImage}
  imageAlt={socialImageAlt}
  imageWidth={socialImageWidth}
  imageHeight={socialImageHeight}
  type="article"
  jsonLd={jsonLd}
>
  <header class="site-header case-site-header">
    <a class="monogram" href="/" aria-label="Retourner à l’accueil">F/M</a>
    <SiteNavigation projectPage client:load />
  </header>

  <main id="contenu" class="case-main">
    <article class="case-study">
      <header class="case-hero">
        <div class="case-hero-copy">
          <p class="eyebrow">Étude de cas</p>
          <h1>{data.title}</h1>
          <p class="case-summary">{data.summary}</p>
          <a class="text-link" href="/#projets"><span aria-hidden="true">←</span> Retour aux projets</a>
        </div>

        <figure class="case-cover" style={`view-transition-name: project-${project.id};`}>
          <img
            src={data.cover.image}
            alt={data.cover.alt}
            width={data.cover.width}
            height={data.cover.height}
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </header>

      <section class="case-section case-facts" aria-labelledby="informations-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">01</p>
          <h2 id="informations-title">Informations essentielles</h2>
        </div>
        <dl>
          {essentialInformation.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="case-section case-narrative" aria-labelledby="probleme-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">02</p>
          <h2 id="probleme-title">Le problème</h2>
        </div>
        <p class="case-statement">{data.problem}</p>
      </section>

      <section class="case-section" aria-labelledby="solution-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">03</p>
          <h2 id="solution-title">La solution</h2>
        </div>
        <ol class="case-numbered-list">
          {data.solution.map((item) => <li>{item}</li>)}
        </ol>
      </section>

      {data.features.length > 0 && (
        <section class="case-section" aria-labelledby="fonctionnalites-title">
          <div class="case-section-heading">
            <p class="case-section-number" aria-hidden="true">04</p>
            <h2 id="fonctionnalites-title">Fonctionnalités principales</h2>
          </div>
          <ul class="case-feature-list">
            {data.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>
      )}

      {data.gallery.length > 0 && (
        <section class="case-section case-gallery-section" aria-labelledby="galerie-title">
          <div class="case-section-heading">
            <p class="case-section-number" aria-hidden="true">05</p>
            <h2 id="galerie-title">Galerie</h2>
          </div>
          <CaseGallery images={data.gallery} projectTitle={data.title} client:load />
        </section>
      )}

      <section class="case-section case-decisions" aria-labelledby="decisions-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">06</p>
          <h2 id="decisions-title">Décisions et apprentissages</h2>
        </div>

        {data.decisions.length > 0 && (
          <ul class="case-decision-list">
            {data.decisions.map((decision) => <li>{decision}</li>)}
          </ul>
        )}

        {hasContent(data.result) && (
          <div class="case-result">
            <h3>Résultat documenté</h3>
            <p>{data.result}</p>
          </div>
        )}

        {hasExtendedDetails && (
          <details class="case-details">
            <summary>Voir le contexte et le fonctionnement technique</summary>
            <div>
              {hasContent(data.context) && (
                <section aria-labelledby="contexte-title">
                  <h3 id="contexte-title">Contexte</h3>
                  <p>{data.context}</p>
                </section>
              )}
              {hasContent(data.architecture) && (
                <section aria-labelledby="architecture-title">
                  <h3 id="architecture-title">Architecture et fonctionnement</h3>
                  <p>{data.architecture}</p>
                </section>
              )}
            </div>
          </details>
        )}
      </section>

      <section class="case-section" aria-labelledby="technologies-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">07</p>
          <h2 id="technologies-title">Technologies</h2>
        </div>
        <ul class="case-technologies">
          {technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </section>

      <section class="case-section case-links" aria-labelledby="liens-title">
        <div class="case-section-heading">
          <p class="case-section-number" aria-hidden="true">08</p>
          <h2 id="liens-title">Liens du projet</h2>
        </div>
        {hasPublicLinks ? (
          <div class="case-link-actions">
            {hasContent(data.demoUrl) && (
              <a class="button button-primary" href={data.demoUrl} target="_blank" rel="noopener noreferrer">
                Voir la démonstration <span class="visually-hidden">— nouvel onglet</span>
              </a>
            )}
            {hasContent(data.githubUrl) && (
              <a class="button button-secondary" href={data.githubUrl} target="_blank" rel="noopener noreferrer">
                Consulter le code source <span class="visually-hidden">— nouvel onglet</span>
              </a>
            )}
          </div>
        ) : (
          <p class="case-link-note">Aucun lien public n’est renseigné pour ce projet.</p>
        )}
        {hasContent(data.codeNote) && <p class="case-link-note">{data.codeNote}</p>}
      </section>

      <nav class="next-project" aria-label="Projet suivant">
        <p>Projet suivant</p>
        <a href={`/projets/${nextProject.id}/`}>
          <span>{nextProject.data.type}</span>
          <strong>{nextProject.data.title}</strong>
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    </article>
  </main>

  <footer class="site-footer">
    <div>
      <a class="monogram" href="/" aria-label="Retourner à l’accueil">F/M</a>
      <p>RAKOTOMALALA Fenotiana Michael<br />Développeur full-stack web et mobile</p>
    </div>
    <nav aria-label="Liens professionnels">
      <a href="mailto:fenotianamichael81@gmail.com">E-mail</a>
      <a href="tel:+261377817771">Téléphone</a>
      <a href="https://github.com/Michael81603" target="_blank" rel="noopener noreferrer">
        GitHub <span class="visually-hidden">— nouvel onglet</span>
      </a>
    </nav>
    <a href="#contenu">Retour en haut ↑</a>
  </footer>
</BaseLayout>
